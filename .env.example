APP_NAME="Tunisian Football Manager"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_TIMEZONE=Africa/Tunis

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=tunisian_football_manager
